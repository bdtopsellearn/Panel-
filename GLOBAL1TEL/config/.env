# GLOBAL1TEL Database Configuration
# Copy this file to .env and update with your production values

# Database Configuration
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=global1tel
DB_USER=global1tel_user
DB_PASS=global1tel_secure_pass_2026

# Application Settings
APP_NAME=GLOBAL1TEL
APP_URL=http://127.0.0.1:8080
APP_ENV=production
APP_DEBUG=false

# Session Configuration
SESSION_LIFETIME=7200
SESSION_NAME=global1tel_session

# Manager Account (Pre-created)
MANAGER_USERNAME=GLOBAL1TEL
MANAGER_PASSWORD=GLOBAL1TEL

# Security
HASH_ALGO=sha256
SALT=mbc_sms_secure_salt_2024

# Jasmin SMS Gateway (Default Configuration)
JASMIN_API_URL=http://localhost
JASMIN_API_PORT=1401
JASMIN_PANEL_PORT=8080
JASMIN_USERNAME=
JASMIN_PASSWORD=
JASMIN_API_KEY=

# SMPP Webhook Security (set a strong random value before enabling receive webhook)
SMPP_WEBHOOK_KEY=TESTKEY123
